rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get, create, update, delete: if isValidId(userId);
      allow list: if true;
    }

    match /reports/{reportId} {
      allow get, create, update, delete: if isValidId(reportId);
      allow list: if true;
    }

    match /departments/{deptId} {
      allow get, create, update, delete: if isValidId(deptId);
      allow list: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
